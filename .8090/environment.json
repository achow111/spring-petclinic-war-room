{
  "name": "Petclinic War Room",
  "install": "MAVEN_OPTS='-Djava.net.preferIPv6Addresses=true' ./mvnw -B -DskipTests package",
  "terminals": [
    {
      "name": "petclinic",
      "command": "MAVEN_OPTS='-Djava.net.preferIPv6Addresses=true' ./mvnw -B spring-boot:run -Dspring-boot.run.arguments=--server.port=8081"
    }
  ],
  "image": "eclipse-temurin:17-jdk-jammy"
}
